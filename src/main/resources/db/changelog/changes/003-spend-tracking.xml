<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Itemised spend tracking, imported from credit-card CSV exports.

      Sits alongside the existing bill ledger rather than replacing it. The two
      work at different grains and never double count:

        balance   joint-chequing running total, one row per bill paid.
        bank_txn  the individual purchases that made up that bill.

      Only markPaid moves the balance; importing a statement never does.

      Imports deliberately store only what the bank sent. Turning a descriptor
      like "LYFT *SCHD AIR 07-22" into merchant "Lyft" and category TRANSPORT is
      done afterwards by a Claude Code skill, which writes its decisions into
      merchant_alias so they are reused on later imports rather than re-derived.
      There is no mapping table: the banks' own labels are kept verbatim on the
      row as a hint for that step, not mechanically translated.

      New tables use snake_case, so unlike the baseline they need no quoting.
      DECIMAL(38,2), VARCHAR lengths and datetime(6) are chosen to match what
      Hibernate expects for the mapped types, so ddl-auto=validate stays happy.
    -->

    <changeSet id="003-1-category" author="jointaccountmanager">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="category"/></not>
        </preConditions>

        <!--
          Categories are rows, not a Java enum, so a one-off like an immigration
          fee or a car repair can be added without a redeploy. The classifier is
          shown this list and reuses it; when nothing fits it may add a row as
          kind=AD_HOC, which then appears in the list it sees next time. That is
          what stops one concept reappearing under three different names.
        -->
        <createTable tableName="category">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(40)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_category_code"/>
            </column>
            <column name="display_name" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <!-- CORE = seeded and stable, AD_HOC = added later for a one-off -->
            <column name="kind" type="VARCHAR(20)" defaultValue="CORE">
                <constraints nullable="false"/>
            </column>
            <!-- ACTIVE | PROPOSED | MERGED -->
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <!-- SEED | AI | USER -->
            <column name="created_by" type="VARCHAR(20)" defaultValue="SEED">
                <constraints nullable="false"/>
            </column>
            <column name="merged_into_id" type="BIGINT"/>
            <column name="created_at" type="datetime(6)"/>
        </createTable>

        <insert tableName="category"><column name="code" value="GROCERIES"/><column name="display_name" value="Groceries"/></insert>
        <insert tableName="category"><column name="code" value="DINING"/><column name="display_name" value="Dining"/></insert>
        <insert tableName="category"><column name="code" value="FUEL"/><column name="display_name" value="Fuel"/></insert>
        <insert tableName="category"><column name="code" value="TRANSPORT"/><column name="display_name" value="Transport"/></insert>
        <insert tableName="category"><column name="code" value="SHOPPING"/><column name="display_name" value="Shopping"/></insert>
        <insert tableName="category"><column name="code" value="HOME"/><column name="display_name" value="Home"/></insert>
        <insert tableName="category"><column name="code" value="RENT"/><column name="display_name" value="Rent"/></insert>
        <insert tableName="category"><column name="code" value="UTILITIES"/><column name="display_name" value="Utilities"/></insert>
        <insert tableName="category"><column name="code" value="INTERNET"/><column name="display_name" value="Internet"/></insert>
        <insert tableName="category"><column name="code" value="HEALTH"/><column name="display_name" value="Health"/></insert>
        <insert tableName="category"><column name="code" value="ENTERTAINMENT"/><column name="display_name" value="Entertainment"/></insert>
        <insert tableName="category"><column name="code" value="TRAVEL"/><column name="display_name" value="Travel"/></insert>
        <insert tableName="category"><column name="code" value="SUBSCRIPTIONS"/><column name="display_name" value="Subscriptions"/></insert>
        <insert tableName="category"><column name="code" value="INSURANCE"/><column name="display_name" value="Insurance"/></insert>
        <insert tableName="category"><column name="code" value="EDUCATION"/><column name="display_name" value="Education"/></insert>
        <insert tableName="category"><column name="code" value="FEES"/><column name="display_name" value="Fees &amp; Interest"/></insert>
        <insert tableName="category"><column name="code" value="CASH"/><column name="display_name" value="Cash &amp; ATM"/></insert>
        <insert tableName="category"><column name="code" value="INCOME"/><column name="display_name" value="Income"/></insert>
        <!-- Card payoffs land here; every spend query filters them out by txn_type anyway. -->
        <insert tableName="category"><column name="code" value="TRANSFER"/><column name="display_name" value="Transfer"/></insert>
        <insert tableName="category"><column name="code" value="OTHER"/><column name="display_name" value="Other"/></insert>
        <!--
          Where every imported row starts. Rows sit here until the classifier
          has looked at them — they still count towards totals, because their
          amounts are parsed deterministically and are correct immediately.
          Only the merchant and category are unknown.
        -->
        <insert tableName="category"><column name="code" value="UNCATEGORIZED"/><column name="display_name" value="Uncategorized"/></insert>
    </changeSet>

    <changeSet id="003-2-statement-import" author="jointaccountmanager">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="statement_import"/></not>
        </preConditions>

        <createTable tableName="statement_import">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="filename" type="VARCHAR(255)"/>
            <!--
              Recognises a file already on record. Only used to report it back:
              the upload is still parsed, because rows it contains may have been
              removed since and re-uploading is how they are restored.
            -->
            <column name="file_sha256" type="VARCHAR(64)"/>
            <column name="imported_at" type="datetime(6)"/>
            <column name="period_start" type="DATE"/>
            <column name="period_end" type="DATE"/>
            <column name="row_count" type="INT"/>
            <column name="inserted_count" type="INT"/>
            <column name="duplicate_count" type="INT"/>
            <column name="status" type="VARCHAR(20)"/>
            <column name="error_message" type="VARCHAR(500)"/>
        </createTable>

        <!--
          Deliberately no foreign key to account. The live database stores
          account.id and records.id as BIGINT UNSIGNED while balance.id is
          signed, and a database built fresh from the baseline makes all three
          signed — so a foreign key here would succeed in one environment and
          fail in the other. The existing schema has never had foreign keys;
          the service layer owns this relationship. An index gives us the
          lookup performance without the portability problem.
        -->
        <createIndex tableName="statement_import" indexName="ix_statement_import_account">
            <column name="account_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-3-bank-txn" author="jointaccountmanager">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="bank_txn"/></not>
        </preConditions>

        <createTable tableName="bank_txn">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Null for rows generated by marking a bill paid rather than imported. -->
            <column name="statement_import_id" type="BIGINT"/>
            <!-- Set on generated rows so amend and revert can find them again. -->
            <column name="record_id" type="BIGINT"/>
            <column name="txn_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="post_date" type="DATE"/>
            <column name="description_raw" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="merchant" type="VARCHAR(120)"/>
            <!--
              Always positive. Chase writes purchases negative and Amex writes
              them positive, so the sign is normalised away at parse time and
              the direction is carried explicitly instead.
            -->
            <column name="amount" type="DECIMAL(38,2)">
                <constraints nullable="false"/>
            </column>
            <!-- DEBIT = money out, CREDIT = money in -->
            <column name="direction" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <!-- PURCHASE | REFUND | PAYMENT | FEE | ADJUSTMENT -->
            <column name="txn_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(40)" defaultValue="UNCATEGORIZED">
                <constraints nullable="false"/>
            </column>
            <!-- AI | USER | BANK | DEFAULT — where the category came from -->
            <column name="category_source" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!-- The bank's own label, kept verbatim so a mapping can be added later. -->
            <column name="bank_category" type="VARCHAR(80)"/>
            <column name="card_member" type="VARCHAR(60)"/>
            <column name="card_ref" type="VARCHAR(20)"/>
            <!-- Amex Reference; null on Chase, which does not publish one. -->
            <column name="source_ref" type="VARCHAR(60)"/>
            <column name="dedup_key" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <!--
              False until the classifier has assigned a merchant and category.
              Imports store exactly what the bank sent and nothing more; naming
              and categorising is a separate, reviewable step.
            -->
            <!--
              BIT(1), not BOOLEAN. Liquibase renders BOOLEAN as tinyint on MySQL
              and Hibernate's validator rejects that for a Java boolean — the
              same mismatch the baseline hit with the is-paid column.
            -->
            <column name="processed" type="BIT(1)" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
        </createTable>

        <!--
          The heart of re-upload safety: overlapping exports collapse onto the
          same key, and the same amount on two different cards cannot collide
          because the account is part of the key.
        -->
        <addUniqueConstraint tableName="bank_txn"
                             columnNames="account_id, dedup_key"
                             constraintName="ux_bank_txn_account_dedup"/>

        <!--
          No foreign key to account or records, for the reason given above. The
          one below is safe because both tables are created by this migration,
          so their column types cannot disagree between environments — and the
          cascade is worth having, since it guarantees undoing an import leaves
          no orphaned transactions behind.
        -->
        <addForeignKeyConstraint baseTableName="bank_txn" baseColumnNames="statement_import_id"
                                 referencedTableName="statement_import" referencedColumnNames="id"
                                 constraintName="fk_bank_txn_import"
                                 onDelete="CASCADE"/>

        <createIndex tableName="bank_txn" indexName="ix_bank_txn_date">
            <column name="txn_date"/>
        </createIndex>
        <createIndex tableName="bank_txn" indexName="ix_bank_txn_account_date">
            <column name="account_id"/>
            <column name="txn_date"/>
        </createIndex>
        <createIndex tableName="bank_txn" indexName="ix_bank_txn_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="bank_txn" indexName="ix_bank_txn_record">
            <column name="record_id"/>
        </createIndex>
        <!-- The classifier's working query is "everything not yet processed". -->
        <createIndex tableName="bank_txn" indexName="ix_bank_txn_processed">
            <column name="processed"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-4-merchant-alias" author="jointaccountmanager">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="merchant_alias"/></not>
        </preConditions>

        <!--
          Maps a suffix-stripped descriptor to a tidy merchant name and category.
          Amazon writes a different order id into every descriptor, so without
          the stripping each purchase would look like a new merchant.
        -->
        <createTable tableName="merchant_alias">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lookup_key" type="VARCHAR(120)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_merchant_alias_key"/>
            </column>
            <column name="merchant" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(40)"/>
            <!-- AI | USER -->
            <column name="source" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-5-account-columns" author="jointaccountmanager">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="account" columnName="statement_format"/></not>
        </preConditions>

        <!--
          Every account row is an outflow from the joint chequing account. Some
          arrive with an itemised CSV, some do not.

            CHASE / AMEX  a statement is imported; nothing is generated.
            NONE          no statement exists, so marking the bill paid
                          generates a single transaction instead.

          Generation additionally requires default_category to be set, so the
          eleven cards below stay inert until they are pointed at a parser.
        -->
        <addColumn tableName="account">
            <column name="statement_format" type="VARCHAR(20)" defaultValue="NONE">
                <constraints nullable="false"/>
            </column>
            <column name="default_category" type="VARCHAR(40)"/>
        </addColumn>
    </changeSet>

    <changeSet id="003-6-configure-direct-pay" author="jointaccountmanager">
        <!--
          The four accounts that are paid straight from chequing with no
          statement behind them. Ids are from the live database; on an empty
          one these update nothing, which is harmless.
        -->
        <update tableName="account">
            <column name="default_category" value="RENT"/>
            <where>id = 12 AND default_category IS NULL</where>
        </update>
        <update tableName="account">
            <column name="default_category" value="RENT"/>
            <where>id = 21 AND default_category IS NULL</where>
        </update>
        <update tableName="account">
            <column name="default_category" value="UTILITIES"/>
            <where>id = 20 AND default_category IS NULL</where>
        </update>
        <update tableName="account">
            <column name="default_category" value="INTERNET"/>
            <where>id = 22 AND default_category IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>
